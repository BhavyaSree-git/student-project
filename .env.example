# Example env file for backend when running with Docker Compose or similar.
# Do NOT commit real secrets to version control. Copy this to .env and fill values.

# Primary option: provide a full DATABASE_URL
# DATABASE_URL=postgresql://user:password@postgres:5432/dbname

# Or provide components (used to build DATABASE_URL when DATABASE_URL is not set)
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=students_db
DATABASE_HOST=postgres
DATABASE_PORT=5432
OPENAI_API_KEY=
# Flask runtime options
FLASK_DEBUG=0
PORT=5000
