# Copy this file to `.env` and fill in the values before running docker-compose.
# Do NOT commit your real keys to version control.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# Database (optional - required for postgres service)
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=students_db
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Optional for direct local Flask runs when PostgreSQL is not running.
# Docker Compose ignores this and connects the backend to its `postgres` service.
# DATABASE_URL=sqlite:///students.db

# Optional runtime flags
FLASK_DEBUG=1
PORT=5000

# Optional frontend API override. By default the browser uses the same host as the frontend.
# VITE_API_BASE=http://your-server-ip:5000/api

# Email delivery for newly created teacher credentials (use an app password where required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
